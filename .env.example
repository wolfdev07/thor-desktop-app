# Environment variables for Thor Desktop Agent

# Django Backend API Configuration
API_BASE_URL=http://localhost:8000
API_PREFIX=valhalla  # API prefix for Django endpoints (/valhalla/api/v1)

# Heimdall WebSocket Configuration
HEIMDALL_WS_URL=ws://localhost:8080
HEIMDALL_PREFIX=heimdall  # WebSocket prefix for Heimdall (/heimdall/api/v1)

# Development Mode
DEV_MODE=false  # Set to 'true' to clear credentials on startup

# Logging
LOG_LEVEL=INFO
